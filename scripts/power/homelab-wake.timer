[Unit]
Description=Daily timer to set RTC wake alarm for 07:00 AM local (Europe/Madrid)
Requires=homelab-wake.service

[Timer]
# Run at 06:55 UTC daily (08:55 CEST / 07:55 CET) — after 07:00 local wake, sets alarm for NEXT day
OnCalendar=*-*-* 06:55:00
Persistent=true
RandomizedDelaySec=0
AccuracySec=1min

[Install]
WantedBy=timers.target